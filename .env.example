# NeuroVision AI - Environment Variables
# Every value below is now actually read by backend/app/config.py
# (a .env file in the repo root is loaded automatically; real environment variables take precedence).

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# Inference device: auto | cpu | cuda
DEVICE=auto

# Model Weights Paths (relative to repo root, or absolute)
NNUNET_WEIGHTS_PATH=models/best_nnunet_model.pt
FASTBRAIN_WEIGHTS_PATH=models/fast_brain_unet.pt
CLASSIFIER_WEIGHTS_PATH=models/best_model.pt

# Monte Carlo Dropout uncertainty
DEFAULT_MC_PASSES=8
UNCERTAINTY_THRESHOLD=35.0
# Fixed variance -> [0,1] scale (identical for every image). Re-calibrate on your own validation data.
UNCERTAINTY_VAR_SCALE=0.06

# Segmentation / classification behaviour
SEG_THRESHOLD=0.5
USE_TTA=true
# If the calibrated top-1 probability is below this, the classifier abstains instead of asserting a type
ABSTAIN_THRESHOLD=0.60
# Fraction of the slice that counts as a real lesion when cross-checking classifier vs. segmentation
LESION_MIN_FRACTION=0.002

# Limits
MAX_UPLOAD_SIZE_MB=100
MAX_STORED_RESULTS=50
